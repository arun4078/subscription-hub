# Copy to .env and fill in. Never commit the real .env.

# Database (SQLite for the quick demo, PostgreSQL for real use)
DATABASE_URL=sqlite:///./brightloop.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/brightloop

# JWT - use a long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60

# Password reset
RESET_TOKEN_MINUTES=30
FRONTEND_URL=http://localhost:3000
# DEV ONLY: also return the reset link in the API response (no email server needed)
EXPOSE_RESET_LINK=true

# First admin account (created at startup if missing)
ADMIN_EMAIL=admin@brightloop.test
ADMIN_PASSWORD=Admin#12345

# Email - leave SMTP_HOST empty to just print reset links in the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brightloop.test
